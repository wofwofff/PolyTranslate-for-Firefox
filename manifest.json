{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.4.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/wofwofff/PolyTranslate-for-Firefox",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "192": "assets/icons/icon-192.png"
  },
  "background": {
    "scripts": ["src/context_menu.js"],
    "service_worker": "src/context_menu.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/*.png", "src/content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "src/options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "polytranslate@wofwofff",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "minimum_chrome_version": "121"
}
